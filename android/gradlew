#!/bin/sh
set -eu
ANDROID_PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${JAVA_HOME:-}" ]; then ANDROID_JAVA="$JAVA_HOME/bin/java"; else ANDROID_JAVA=java; fi
exec "$ANDROID_JAVA" -classpath "$ANDROID_PROJECT_DIR/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
